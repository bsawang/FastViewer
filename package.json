{
  "name": "fastviewer",
  "version": "0.1.0",
  "private": true,
  "description": "FastViewer — 自用图片浏览器（Electron 双层壳）",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx scripts/build.ts && node scripts/start.ts",
    "build": "tsx scripts/build.ts",
    "icons": "tsx scripts/file-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.6.5",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
